# ==============================================================================
# RoamPup Environment Variables
# Copy this file to .env.local and fill in your values
# ==============================================================================

# MongoDB Connection String (Atlas or Local)
# Example MongoDB Atlas URI:
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/roampup?retryWrites=true&w=majority&appName=RoamPup"
MONGODB_URI=""

# Auth.js / NextAuth Secret
# Generate a secure secret using: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=""

# NextAuth URL (optional in production, useful locally)
AUTH_URL="http://localhost:3000"

# Optional future integrations (Gemini AI, Google OAuth)
# GEMINI_API_KEY=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
